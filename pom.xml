<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.rag.airagservice</groupId>
    <artifactId>ai-rag-service</artifactId>
    <version>1.0-SNAPSHOT</version>

    <parent>
        <groupId>com.be.common</groupId>
        <artifactId>common-be-multimodule</artifactId>
        <version>1.7.5</version>
    </parent>
    <properties>
        <version.common.be>1.7.5</version.common.be>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.be.common</groupId>
            <artifactId>builder</artifactId>
        </dependency>
        <dependency>
            <groupId>com.be.common</groupId>
            <artifactId>jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.be.common</groupId>
            <artifactId>ai</artifactId>
        </dependency>
        <!-- Ollama (requires server) -->
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-ollama</artifactId>
        </dependency>
        <!-- PgVector store -->
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-pgvector</artifactId>
        </dependency>
        <dependency>
            <groupId>com.be.common</groupId>
            <artifactId>rest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.be.common</groupId>
            <artifactId>flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.be.common</groupId>
            <artifactId>test</artifactId>
        </dependency>
        <dependency>
            <groupId>com.be.common</groupId>
            <artifactId>rest-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <!-- ==================== -->
        <!-- = MAPPER GENERATOR = -->
        <!-- ==================== -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.be.common</groupId>
                <artifactId>bom</artifactId>
                <version>${version.common.be}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/Mauro2888/java-common-be</url>
        </repository>
